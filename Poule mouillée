<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Poule mouillée</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=DM+Mono:wght@500&family=Figtree:wght@400;500;600&display=swap">
<style>
/* Concept : une table de feutre bordeaux vue de dessus, compacte. Colonne de jeu à gauche (scores, plateau, actions), colonne latérale à droite (valeur des dés toujours visible, manches, joueurs et réglages). Chaque joueur a sa couleur. Thème sombre unique, par choix. */
:root {
  --felt: #4b1626;
  --felt-deep: #34101c;
  --felt-hi: #62213a;
  --line: #7a374d;
  --text: #f6edef;
  --muted: #cfaeb7;
  --accent: #5fe0c4;
  --accent-ink: #06352c;
  --warn: #ffa270;
  --ivory: #f6efe0;
  --ivory-edge: #cdbf9f;
  --pip: #231a1d;
  --p0: #5fe0c4;
  --p1: #ffcf6e;
  --p2: #ff8fb1;
  --p3: #7cc4ff;
  --p4: #c4a3ff;
  --p5: #b9e66b;
  --font-display: 'Bricolage Grotesque', 'Trebuchet MS', system-ui, sans-serif;
  --font-body: 'Figtree', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --font-mono: 'DM Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
  color-scheme: dark;
}
* { box-sizing: border-box; }
html, body { height: 100%; }
body {
  background-color: var(--felt-deep);
  background-image: radial-gradient(ellipse at 40% 0%, var(--felt-hi) 0%, var(--felt-deep) 62%);
  background-repeat: no-repeat;
  color: var(--text);
  font-family: var(--font-body);
  font-size: 15px;
  line-height: 1.4;
  padding-inline: 16px;
  padding-block: 12px;
}
.app { max-width: 62rem; height: 100%; min-height: 31rem; margin-inline: auto; display: grid; grid-template-columns: minmax(0, 1fr) 16rem; gap: 14px; }
.main { display: flex; flex-direction: column; gap: 10px; min-width: 0; min-height: 0; }
.side { display: flex; flex-direction: column; gap: 10px; min-width: 0; min-height: 0; overflow-y: auto; }

header { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 14px; }
h1 { font-family: var(--font-display); font-weight: 800; font-size: 2rem; line-height: 1; letter-spacing: -0.02em; margin: 0; }
.goal { margin: 0; color: var(--muted); font-size: 0.9rem; }
.record { margin: 0 0 0 auto; min-width: 0; text-align: right; font-family: var(--font-mono); font-size: 0.78rem; color: var(--muted); }

.scores { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
.card { background: var(--felt-deep); border: 2px solid var(--line); border-radius: 12px; padding: 8px 12px 7px; min-width: 0; transition: border-color .2s; }
.card.active { border-color: var(--pc, var(--accent)); }
.card h2 { margin: 0; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.card h2::before { content: ''; display: inline-block; width: 0.6em; height: 0.6em; margin-right: 0.5em; border-radius: 50%; background: var(--pc, var(--accent)); }
.total { margin: 0 0 4px; font-family: var(--font-mono); font-weight: 500; font-size: 1.7rem; line-height: 1.15; font-variant-numeric: tabular-nums; }
.card.compact .total { font-size: 1.35rem; }
.card.compact { padding-inline: 10px; }
.card.dense { padding-block: 5px 4px; }
.card.dense .total { font-size: 1.2rem; margin-bottom: 2px; }
.card.dense .sub { margin-top: 2px; font-size: 0.7rem; min-height: 1em; }
.bar { height: 4px; border-radius: 2px; background: var(--felt); overflow: hidden; }
.bar span { display: block; height: 100%; background: var(--pc, var(--accent)); border-radius: 2px; transition: width .4s; }
.sub { margin: 4px 0 0; font-size: 0.76rem; color: var(--muted); min-height: 1.2em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.board { position: relative; flex: 1; min-height: 0; background: var(--felt); border: 2px solid var(--line); border-radius: 18px; padding: 14px 16px; display: flex; flex-direction: column; justify-content: space-between; gap: 10px; box-shadow: inset 0 0 50px rgba(0, 0, 0, 0.28); }
.msg { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; line-height: 1.25; min-height: 2.5em; text-wrap: balance; }
.msg.bad { color: var(--warn); }
.boardtop { display: flex; flex-wrap: wrap; align-items: flex-start; gap: 10px 16px; }
.boardtop .msg { flex: 1 1 14rem; min-width: 0; }
.till { flex: none; display: flex; align-items: center; gap: 12px; max-width: 100%; background: var(--felt-deep); border: 2px solid var(--line); border-radius: 16px; padding: 8px 20px 8px 12px; transition: border-color .2s; }
.till.has { border-color: var(--accent); }
.till.bad { border-color: var(--warn); }
.till { --chip-hi: #5fe0c4; --chip-mid: #3fb89f; --chip-lo: #247a68; }
.till.bad { --chip-hi: #ffa270; --chip-mid: #e0804f; --chip-lo: #8f4a24; }
.chip-hi { fill: var(--chip-hi); stroke: var(--chip-lo); stroke-width: 1; }
.chip-mid { fill: var(--chip-mid); stroke: var(--chip-lo); stroke-width: 1; stroke-linejoin: round; }
.chip-mark { fill: var(--ivory); }
.chip-ring { fill: none; stroke: var(--ivory); stroke-width: 1.3; stroke-dasharray: 3.4 2.6; }
.chip-shadow { fill: rgba(0, 0, 0, 0.3); }
.chip-top { animation: chipdrop .3s ease-out; }
@keyframes chipdrop { from { transform: translateY(-12px); opacity: 0; } to { transform: none; opacity: 1; } }
.reg { width: 84px; height: 70px; flex: none; }
.tillText { display: flex; flex-direction: column; min-width: 9rem; max-width: 14rem; }
.tillText .label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.tillAmt { display: inline-block; align-self: flex-start; transform-origin: left center; font-family: var(--font-mono); font-weight: 500; font-size: clamp(2.8rem, 9vw, 3.6rem); line-height: 1; color: var(--accent); font-variant-numeric: tabular-nums; }
.till.bad .tillAmt { color: var(--warn); }
.tillSub { font-size: 0.76rem; color: var(--muted); min-height: 1.15em; }
.tillAmt.bump { animation: bump .45s ease-out; }
@keyframes bump { 0% { transform: scale(1); } 40% { transform: scale(1.25); } 100% { transform: scale(1); } }
.draw { position: absolute; inset: 0; z-index: 2; display: grid; place-content: center; justify-items: center; gap: 14px; text-align: center; background: rgba(52, 16, 28, 0.96); border-radius: 16px; padding: 20px; }
.draw h2 { margin: 0; font-family: var(--font-display); font-size: clamp(1.5rem, 5vw, 2.1rem); line-height: 1.1; }
.draw p { margin: 0; color: var(--muted); min-height: 1.5em; text-wrap: balance; }
.drawrow { display: flex; flex-wrap: wrap; gap: 14px 22px; justify-content: center; }
.drawcol { display: flex; flex-direction: column; align-items: center; gap: 8px; min-width: 0; transition: opacity .3s; }
.drawcol.out { opacity: 0.35; }
.drawcol .label { color: var(--pc, var(--muted)); max-width: 6.5rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bigdie { width: clamp(3.4rem, 12vw, 5rem); }
.dice { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: clamp(6px, 1.6vw, 12px); max-width: 28rem; width: 100%; padding-top: 8px; }
.slot { aspect-ratio: 1; border-radius: 18%; border: 2px dashed rgba(255, 255, 255, 0.12); }
.slot.ghost { border-color: rgba(246, 239, 224, 0.4); }
.die { display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); width: 100%; aspect-ratio: 1; padding: 15%; background: var(--ivory); border-radius: 18%; border: 0; box-shadow: 0 4px 0 var(--ivory-edge), 0 7px 12px rgba(0, 0, 0, 0.35); }
.p { display: block; width: 78%; aspect-ratio: 1; height: auto; margin: auto; border-radius: 50%; background: var(--pip); visibility: hidden; }
.p.on { visibility: visible; }
button.die { cursor: pointer; transition: transform .12s, box-shadow .12s; font: inherit; }
button.die:hover { transform: translateY(-2px); }
button.die.sel { transform: translateY(-8px); box-shadow: 0 0 0 4px var(--accent), 0 4px 0 var(--ivory-edge), 0 12px 14px rgba(0, 0, 0, 0.35); }
.die.tumble { animation: tumble .45s cubic-bezier(.2, .8, .3, 1) both; animation-delay: calc(var(--i) * 50ms); }
@keyframes tumble { from { transform: translateY(-24px) rotate(-130deg); opacity: 0; } to { transform: none; opacity: 1; } }
.die.pick { animation: pick .4s ease-out; }
@keyframes pick { 0% { transform: translateY(0) scale(1); } 45% { transform: translateY(-16px) scale(1.15); } 100% { transform: translateY(-8px) scale(1); } }
.die.out { animation: out .4s ease-in forwards; pointer-events: none; }
@keyframes out { to { transform: translateY(90px) scale(0.4); opacity: 0; } }
span.die.idle { opacity: 0.7; }

.keptwrap { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 10px; min-height: 1.9rem; }
.label { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
.kept { display: flex; flex-wrap: wrap; gap: 5px; }
.kept .die { width: 1.9rem; height: 1.9rem; flex: none; padding: 0.3rem; border-radius: 0.4rem; box-shadow: 0 3px 0 var(--ivory-edge); }
.kept .die.land { animation: land .45s cubic-bezier(.2, .8, .3, 1) both; }
@keyframes land { from { transform: translateY(-46px) scale(1.8); opacity: 0; } to { transform: none; opacity: 1; } }
.sel-info { margin: 0; color: var(--muted); font-size: 0.88rem; min-height: 2.6em; }
.actions { display: flex; flex-wrap: wrap; gap: 8px; }
.btn { font-family: var(--font-body); font-weight: 600; font-size: 0.95rem; padding: 9px 14px; border-radius: 10px; border: 2px solid var(--accent); background: transparent; color: var(--accent); cursor: pointer; min-height: 44px; transition: background .15s, color .15s; }
.btn:hover:not(:disabled) { background: rgba(95, 224, 196, 0.14); }
.btn.primary { background: var(--accent); color: var(--accent-ink); }
.btn.primary:hover:not(:disabled) { background: #86ecd6; }
.btn.ghost { border-color: var(--line); color: var(--text); }
.btn.small { min-height: 36px; padding: 5px 12px; font-size: 0.85rem; }
.btn:disabled { opacity: 0.35; cursor: not-allowed; }
.btn:focus-visible, button.die:focus-visible, summary:focus-visible, input:focus-visible, select:focus-visible, .pdel:focus-visible { outline: 3px solid var(--text); outline-offset: 2px; }
.actions .btn { flex: 1 1 9rem; }

.over { position: absolute; inset: 0; z-index: 3; display: grid; place-content: center; justify-items: center; gap: 12px; text-align: center; background: rgba(52, 16, 28, 0.93); border-radius: 16px; padding: 20px; }
.over h2 { margin: 0; font-family: var(--font-display); font-size: clamp(1.6rem, 5vw, 2.3rem); line-height: 1.1; text-wrap: balance; }
.over p { margin: 0; color: var(--muted); text-wrap: balance; }

.panel { background: var(--felt-deep); border: 2px solid var(--line); border-radius: 12px; padding: 10px 12px; }
.panel h2 { margin: 0 0 6px; font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); font-weight: 600; }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 0.85rem; }
td { padding: 1px 4px; border-bottom: 1px solid rgba(122, 55, 77, 0.6); }
tr:last-child td { border-bottom: 0; }
td:last-child { font-family: var(--font-mono); font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; vertical-align: middle; }
.faces.note { flex-wrap: nowrap; }
.faces small { flex: 1 1 3.2rem; min-width: 0; font-family: var(--font-body); font-size: 0.68rem; line-height: 1.15; color: var(--muted); white-space: normal; }
td { vertical-align: middle; }
.faces { display: flex; flex-wrap: wrap; align-items: center; gap: 3px 10px; }
.grp { display: flex; gap: 3px; }
.faces .die { width: 1.15rem; height: 1.15rem; flex: none; padding: 0.17rem; border-radius: 0.28rem; box-shadow: 0 2px 0 var(--ivory-edge); }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

#settings { display: flex; flex-direction: column; gap: 4px; margin-top: 6px; }
.sethead { font-size: 0.72rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); font-weight: 600; margin-top: 2px; }
.plist { list-style: none; margin: 0 0 2px; padding: 0; display: flex; flex-direction: column; gap: 6px; }
.prow { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; gap: 6px; align-items: center; }
.pdot { width: 0.7rem; height: 0.7rem; border-radius: 50%; background: var(--pc); }
.prow input { padding: 6px 8px; font-size: 0.88rem; }
select { font-family: var(--font-body); font-size: 0.85rem; padding: 6px 4px; border-radius: 8px; border: 2px solid var(--line); background: var(--felt); color: var(--text); }
.pdel { width: 2rem; height: 2rem; border-radius: 8px; border: 2px solid var(--line); background: transparent; color: var(--text); font-size: 1.1rem; line-height: 1; cursor: pointer; }
.pdel:hover:not(:disabled) { border-color: var(--warn); color: var(--warn); }
.pdel:disabled { opacity: 0.3; cursor: not-allowed; }

.histpanel { flex: 1 1 auto; min-height: 8rem; display: flex; flex-direction: column; }
.hist { list-style: none; margin: 0; padding: 0; flex: 1; min-height: 0; overflow-y: auto; display: flex; flex-direction: column; }
.hrow { display: grid; grid-template-columns: 4.4rem minmax(0, 1fr) auto; align-items: center; gap: 6px; padding: 5px 4px; border-bottom: 1px solid rgba(122, 55, 77, 0.6); }
.hrow:last-child { border-bottom: 0; }
.hrow.live { background: rgba(95, 224, 196, 0.08); border-radius: 8px; }
.hwho { display: flex; flex-direction: column; min-width: 0; line-height: 1.15; }
.hwho b { font-family: var(--font-mono); font-weight: 500; font-size: 0.7rem; color: var(--muted); }
.hwho span { font-size: 0.8rem; font-weight: 600; color: var(--pc, var(--text)); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.hdice { display: flex; flex-wrap: wrap; align-items: center; gap: 3px 8px; min-width: 0; }
.hdice .grp { flex-wrap: wrap; }
.hdice .die { width: 1.15rem; height: 1.15rem; flex: none; padding: 0.16rem; border-radius: 0.25rem; box-shadow: 0 2px 0 var(--ivory-edge); }
.hdice .grp.dead .die { opacity: 0.5; box-shadow: 0 0 0 2px var(--warn); }
.hpts { display: flex; flex-direction: column; align-items: flex-end; font-family: var(--font-mono); font-variant-numeric: tabular-nums; font-size: 0.95rem; line-height: 1.1; white-space: nowrap; }
.hpts.bad { color: var(--warn); }
.hrow.live .hpts { color: var(--accent); }
.hpts small { font-size: 0.68rem; color: var(--muted); }
.hnone, .hempty { color: var(--muted); font-size: 0.78rem; }
label { font-size: 0.8rem; color: var(--muted); margin-top: 4px; }
input { font-family: var(--font-body); font-size: 0.95rem; width: 100%; padding: 7px 9px; border-radius: 8px; border: 2px solid var(--line); background: var(--felt); color: var(--text); }
form .btn { margin-top: 6px; min-height: 40px; padding-block: 6px; }
.hint { margin: 4px 0 0; font-size: 0.76rem; color: var(--muted); min-height: 2.4em; }
.credit { margin: 0; padding: 2px 4px 0; text-align: right; font-size: 0.7rem; color: var(--muted); opacity: 0.55; }
.rules summary, .settings summary { cursor: pointer; font-weight: 600; font-size: 0.9rem; }
.rules ul { margin: 8px 0 0; padding-left: 1.1rem; display: flex; flex-direction: column; gap: 4px; font-size: 0.82rem; color: var(--muted); }

@media (max-width: 760px) {
  html, body { height: auto; }
  .app { grid-template-columns: minmax(0, 1fr); height: auto; min-height: 0; }
  .side { overflow: visible; }
  .histpanel { flex: none; }
  .hist { max-height: 15rem; }
  .board { flex: none; }
  .dice { max-width: none; }
  body { padding-block: 16px 32px; }
}
@media (prefers-reduced-motion: reduce) {
  .die.tumble, .die.pick, .die.out, .kept .die.land, .tillAmt.bump, .chip-top { animation: none; }
  .bar span, button.die, .card, .drawcol { transition: none; }
}
</style>

<div class="app">
  <div class="main">
    <header>
      <h1>Poule mouillée</h1>
      <p class="goal" id="goalText"></p>
      <p class="record" id="record"></p>
      <button class="btn ghost small" id="btnNew" type="button">Nouvelle partie</button>
      <button class="btn ghost small" id="btnSound" type="button" aria-pressed="true">Son : oui</button>
    </header>

    <section class="scores" id="scores" aria-label="Pointage"></section>

    <main class="board">
      <div class="boardtop">
        <p class="msg" id="msg" aria-live="polite"></p>
        <div class="till" id="till">
          <svg class="reg" id="chips" viewBox="0 0 72 60" aria-hidden="true"></svg>
          <div class="tillText">
            <span class="label" id="tillLabel">Caisse du tour</span>
            <span class="tillAmt" id="tillAmt">0</span>
            <span class="tillSub" id="tillSub"></span>
          </div>
        </div>
      </div>
      <div class="dice" id="dice"></div>
      <div class="keptwrap" id="keptwrap">
        <span class="label">Mis de côté</span>
        <div class="kept" id="kept"></div>
      </div>
      <p class="sel-info" id="selinfo"></p>
      <div class="actions">
        <button class="btn primary" id="btnRoll" type="button">Lancer les dés</button>
        <button class="btn" id="btnKeep" type="button">Garder</button>
        <button class="btn" id="btnBank" type="button">Encaisser</button>
      </div>
      <div class="draw" id="draw" hidden>
        <h2>Qui commence?</h2>
        <div class="drawrow" id="drawDice"></div>
        <p id="drawNote"></p>
        <button class="btn primary" id="btnDraw" type="button">Lancer les dés</button>
      </div>
      <div class="over" id="over" hidden>
        <h2 id="overTitle"></h2>
        <p id="overText"></p>
        <button class="btn primary" id="btnAgain" type="button">Rejouer</button>
      </div>
    </main>
  </div>

  <aside class="side">
    <section class="panel" aria-label="Valeur des dés">
      <h2>Valeur des dés</h2>
      <div class="table-wrap">
        <table>
          <tbody id="valuesBody"></tbody>
        </table>
      </div>
    </section>

    <section class="panel histpanel" aria-label="Manches">
      <h2>Manches</h2>
      <ul class="hist" id="hist"></ul>
    </section>

    <details class="panel settings">
      <summary>Joueurs et réglages</summary>
      <form id="settings" autocomplete="off">
        <span class="sethead" id="plistLabel">Joueurs (2 à 4)</span>
        <ul class="plist" id="plist" aria-labelledby="plistLabel"></ul>
        <button class="btn ghost small" id="btnAddP" type="button">Ajouter un joueur</button>
        <label for="inGoal">Points pour gagner</label>
        <input id="inGoal" type="number" min="1000" max="100000" step="500" inputmode="numeric">
        <label for="inEntry">Points pour entrer</label>
        <input id="inEntry" type="number" min="0" max="5000" step="50" inputmode="numeric">
        <button class="btn" id="btnApply" type="submit">Appliquer</button>
        <p class="hint" id="setHint">Changer les joueurs ou les points recommence la partie.</p>
      </form>
    </details>

    <details class="panel rules">
      <summary>Règles</summary>
      <ul id="rulesList"></ul>
    </details>

    <p class="credit">Par Bernard Michaud</p>
  </aside>
</div>

<script>
