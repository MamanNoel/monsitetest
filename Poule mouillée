  function isCpuDefault(i) { return P[i].cpu && !P[i].name && cpus() === 1; }
  function subj(i) { return isYou(i) ? 'Tu' : (isCpuDefault(i) ? 'L’ordinateur' : nm(i)); }
  function forWho(i) { return isYou(i) ? 'toi' : (isCpuDefault(i) ? 'l’ordinateur' : nm(i)); }
