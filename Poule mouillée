      { g: [[5]], pts: '50', label: 'Un 5' },
      { g: [[1, 1, 1]], pts: '1 000', label: 'Trois 1' },
      { g: [[2, 2, 2]], pts: '200', label: 'Trois 2' },
      { g: [[3, 3, 3]], pts: '300', label: 'Trois 3' },
      { g: [[4, 4, 4]], pts: '400', label: 'Trois 4' },
      { g: [[5, 5, 5]], pts: '500', label: 'Trois 5' },
      { g: [[6, 6, 6]], pts: '600', label: 'Trois 6' },
      { g: [[4, 4, 4, 4]], pts: '800', note: '× 2 par dé en plus', label: 'Quatre dés identiques, puis fois deux pour chaque dé identique en plus' },
      { g: [[1, 2, 3, 4, 5, 6]], pts: '1 500', label: 'Suite de 1 à 6' },
      { g: [[2, 2], [3, 3], [6, 6]], pts: '1 500', label: 'Trois paires' }
    ];
    $('valuesBody').innerHTML = rows.map(function (r) {
      var faces = r.g.map(function (grp) {
        return '<span class="grp">' + grp.map(function (v) { return dieHTML(v, 'span', ''); }).join('') + '</span>';
      }).join('');
      return '<tr><td><span class="sr">' + r.label + '</span><span class="faces' + (r.note ? ' note' : '') + '" aria-hidden="true">' + faces + (r.note ? '<small>' + r.note + '</small>' : '') + '</span></td><td>' + r.pts + '</td></tr>';
    }).join('');
  }
  function renderRules() {
    $('rulesList').innerHTML =
      '<li>Chaque joueur joue à son tour. Le premier à atteindre ' + fmt(GOAL) + ' points gagne.</li>' +
      '<li>Lance six dés, garde au moins un dé qui compte, puis relance les autres ou encaisse.</li>' +
      '<li>Si aucun dé ne compte, c’est raté : les points du tour sont perdus.</li>' +
      '<li>Si les six dés comptent, on relance les six (dés chauds).</li>' +
      '<li>' + (ENTRY > 0 ? 'Pour entrer dans la partie, il faut encaisser au moins ' + fmt(ENTRY) + ' points dans un même tour.' : 'Aucun minimum pour entrer dans la partie.') + '</li>' +
      '<li>Chaque dé gardé doit rapporter des points.</li>';
  }

  function renderScores() {
    var n = P.length, narrow = window.innerWidth <= 760;
    var cols = narrow ? Math.min(n, 2) : (n <= 4 ? n : 3);
    var compact = n > 2, dense = n > 4;
    var el = $('scores');
    el.style.gridTemplateColumns = 'repeat(' + cols + ', minmax(0, 1fr))';
    el.innerHTML = P.map(function (p, i) {
      var active = S.turn === i && !S.over && S.phase !== 'draw';
      var sub;
      if (active && S.pts > 0) sub = (compact ? 'Main : ' : 'Dans la main : ') + fmt(S.pts);
      else if (!S.board[i] && ENTRY > 0) sub = compact ? 'Pas entré' : 'Pas encore entré (' + fmt(ENTRY) + ' pour démarrer)';
      else sub = ' ';
      return '<article class="card' + (active ? ' active' : '') + (compact ? ' compact' : '') + (dense ? ' dense' : '') + '" style="--pc:var(--p' + i + ')"><h2>' + esc(nm(i)) + '</h2>' +
        '<p class="total">' + fmt(S.scores[i]) + '</p>' +
        '<div class="bar"><span style="width:' + Math.min(100, S.scores[i] / GOAL * 100) + '%"></span></div>' +
        '<p class="sub">' + esc(sub) + '</p></article>';
    }).join('');
  }

  function render() {
    $('goalText').textContent = 'Premier à ' + fmt(GOAL) + ' points';
    renderScores();

    var msg = $('msg');
    msg.textContent = S.msg;
    msg.className = 'msg' + (S.bad ? ' bad' : '');

    var html = '', i;
    for (i = 0; i < 6; i++) {
      var d = S.roll[i];
      if (d && d.idle) {
        html += dieHTML(d.v, 'span', 'idle', ' aria-label="Dé ' + d.v + ', en attente"');
      } else if (d) {
        var cls = (d.sel ? 'sel ' : '') + (d.pick ? 'pick ' : '') + (d.fresh ? 'tumble' : '');
        var extra = ' style="--i:' + i + '" aria-label="Dé ' + d.v + (d.sel ? ', gardé' : '') + '" aria-pressed="' + (d.sel ? 'true' : 'false') + '" data-i="' + i + '" type="button"';
        html += dieHTML(d.v, 'button', cls, extra);
      } else if (S.phase === 'ready' && !S.over && i < S.left) {
        html += '<div class="slot ghost"></div>';
      } else {
        html += '<div class="slot"></div>';
      }
    }
    $('dice').innerHTML = html;
    S.roll.forEach(function (d) { d.fresh = false; d.pick = false; });

    var newFrom = S.kept.length - S.keptNew;
    $('kept').innerHTML = S.kept.map(function (v, k) { return dieHTML(v, 'span', k >= newFrom ? 'land' : ''); }).join('');
    S.keptNew = 0;
    $('keptwrap').style.visibility = S.kept.length ? 'visible' : 'hidden';

    var human = !P[S.turn].cpu && !S.busy && !S.over;
    var cs = curSel(), sc = cs.sc;
    var canKeep = human && S.phase === 'choosing' && sc !== null;
    var canBank = canKeep && (S.board[S.turn] || S.pts + sc >= ENTRY);
    $('btnRoll').disabled = !(human && S.phase === 'ready');
    $('btnRoll').textContent = 'Lancer ' + S.left + (S.left > 1 ? ' dés' : ' dé');
    $('btnKeep').disabled = !canKeep;
    $('btnKeep').textContent = canKeep ? 'Garder ' + fmt(sc) : 'Garder';
    $('btnBank').disabled = !canBank;
    $('btnBank').textContent = canBank ? 'Encaisser ' + fmt(S.pts + sc) : 'Encaisser';

    var info = '';
    if (human && S.phase === 'choosing') {
      if (!cs.sel.length) info = 'Touche les dés à garder.';
      else if (sc === null) info = 'Cette sélection ne compte pas. Chaque dé choisi doit rapporter des points.';
      else {
        info = 'Sélection : ' + fmt(sc) + ' points. Total du tour avec cette sélection : ' + fmt(S.pts + sc) + '.';
        if (!canBank) info += ' Il faut ' + fmt(ENTRY) + ' points dans un même tour pour entrer dans la partie.';
      }
    } else if (human && S.phase === 'ready' && S.pts > 0) {
      info = subj(S.turn) + ' ' + V(S.turn, 'a', 'as') + ' ' + fmt(S.pts) + ' points en main et ' + S.left + (S.left > 1 ? ' dés' : ' dé') + ' à relancer.';
    }
    $('selinfo').textContent = info;

    var tillLabel, tillAmt = 0, tillSub = '', tillCls = 'till';
    if (S.phase === 'banked' || S.phase === 'over') {
      tillLabel = 'Encaissé'; tillAmt = S.banked; tillCls += ' has';
    } else if (S.phase === 'farkle') {
      tillLabel = 'Raté'; tillAmt = 0; tillCls += ' bad';
      tillSub = S.lost > 0 ? fmt(S.lost) + ' points perdus' : '';
    } else {
      if (S.phase === 'draw') tillLabel = 'Caisse du tour';
      else if (isYou(S.turn)) tillLabel = 'Caisse de ton tour';
      else if (isCpuDefault(S.turn)) tillLabel = 'Caisse de l’ordinateur';
      else tillLabel = 'Caisse · ' + nm(S.turn);
      tillAmt = S.pts;
      if (tillAmt > 0) tillCls += ' has';
      if (human && S.phase === 'choosing' && sc !== null) tillSub = '+ ' + fmt(sc) + ' avec cette sélection';
    }
    $('till').className = tillCls;
    $('tillLabel').textContent = tillLabel;
    $('tillSub').textContent = tillSub;
    var amtEl = $('tillAmt');
    amtEl.textContent = fmt(tillAmt);
    if (tillAmt > lastAmt) {
      amtEl.classList.remove('bump');
      void amtEl.offsetWidth;
      amtEl.classList.add('bump');
    }
    lastAmt = tillAmt;
    setChips(tillAmt);

    $('draw').hidden = S.phase !== 'draw';
    if (S.phase === 'draw') {
      var dr = S.draw;
      $('drawDice').innerHTML = P.map(function (p, k) {
        var inC = dr.cont.indexOf(k) > -1;
        return '<div class="drawcol' + (inC ? '' : ' out') + '" style="--pc:var(--p' + k + ')">' + bigDie(dr.vals[k], dr.fresh === k) + '<span class="label">' + esc(nm(k)) + '</span></div>';
      }).join('');
      $('drawNote').textContent = dr.note;
      $('btnDraw').disabled = dr.rolling;
      dr.fresh = -1;
    }

    $('over').hidden = !S.over;
    if (S.over) {
      var w = S.winner;
      $('overTitle').textContent = isYou(w) ? 'Bravo' + (P[w].name ? ' ' + P[w].name : '') + ', tu as gagné!' : (isCpuDefault(w) ? 'L’ordinateur gagne cette fois' : 'Bravo ' + nm(w) + '!');
      var order = P.map(function (p, k) { return k; }).sort(function (a, b) { return S.scores[b] - S.scores[a]; });
      $('overText').textContent = 'Score final : ' + order.map(function (k) { return nm(k) + ' ' + fmt(S.scores[k]); }).join(' · ') + '.';
    }

    var champs = P.map(function (p, k) { return { n: nm(k), w: winsOf(nm(k)) }; }).filter(function (c) { return c.w > 0; });
    $('record').textContent = champs.length ? 'Victoires : ' + champs.map(function (c) { return c.n + ' ' + c.w; }).join(' · ') : '';
    renderHistory();
  }

  /* ---------- Actions des joueurs ---------- */
  function humanTurn() { return S && !P[S.turn].cpu && !S.busy && !S.over; }
  $('dice').addEventListener('click', function (e) {
    var b = e.target.closest('button.die');
    if (!b) return;
    if (!(humanTurn() && S.phase === 'choosing')) return;
    var d = S.roll[+b.getAttribute('data-i')];
    if (d) { d.sel = !d.sel; render(); }
  });
  $('btnRoll').addEventListener('click', function () {
    if (humanTurn() && S.phase === 'ready') doRoll();
  });
  $('btnKeep').addEventListener('click', function () {
    if (humanTurn() && S.phase === 'choosing') flyAndKeep(false);
  });
  $('btnBank').addEventListener('click', function () {
    if (humanTurn() && S.phase === 'choosing') flyAndKeep(true);
  });
  $('btnNew').addEventListener('click', newGame);
  $('btnSound').addEventListener('click', function () {
    soundOn = !soundOn;
    try { localStorage.setItem('farkle-sound', soundOn ? 'on' : 'off'); } catch (e) {}
    drawSoundButton();
    if (soundOn) rollSound(2);
  });
  $('btnDraw').addEventListener('click', drawRoll);
  $('btnAgain').addEventListener('click', newGame);
  window.addEventListener('resize', function () { if (S) renderScores(); });

  /* ---------- Joueurs et réglages ---------- */
  function readDraft() {
    DRAFT = DRAFT.map(function (p, i) {
      var n = $('pn' + i), t = $('pt' + i);
      return { name: n ? n.value : p.name, cpu: t ? t.value === 'c' : p.cpu };
    });
  }
  function drawPlayerRows() {
    $('plist').innerHTML = DRAFT.map(function (p, i) {
      return '<li class="prow" style="--pc:var(--p' + i + ')"><span class="pdot"></span>' +
        '<input id="pn' + i + '" type="text" maxlength="16" placeholder="' + esc(defName(DRAFT, i)) + '" value="' + esc(p.name) + '" aria-label="Nom du joueur ' + (i + 1) + '">' +
        '<select id="pt' + i + '" aria-label="Type du joueur ' + (i + 1) + '"><option value="h"' + (p.cpu ? '' : ' selected') + '>Humain</option><option value="c"' + (p.cpu ? ' selected' : '') + '>Ordi</option></select>' +
        '<button class="pdel" id="pd' + i + '" type="button" data-i="' + i + '" aria-label="Retirer le joueur ' + (i + 1) + '"' + (DRAFT.length <= 2 ? ' disabled' : '') + '>×</button></li>';
    }).join('');
    $('btnAddP').disabled = DRAFT.length >= MAXP;
  }
  function refreshPlaceholders() {
    DRAFT.forEach(function (p, i) {
      var n = $('pn' + i);
      if (n) n.placeholder = defName(DRAFT, i);
    });
  }
  function fillForm() {
    $('inGoal').value = GOAL;
    $('inEntry').value = ENTRY;
    DRAFT = P.map(function (p) { return { name: p.name, cpu: p.cpu }; });
    drawPlayerRows();
  }
  $('plist').addEventListener('click', function (e) {
    var b = e.target.closest('.pdel');
    if (!b || b.disabled) return;
    readDraft();
    DRAFT.splice(+b.getAttribute('data-i'), 1);
    drawPlayerRows();
  });
  $('plist').addEventListener('change', function (e) {
    if (e.target.tagName === 'SELECT') { readDraft(); refreshPlaceholders(); }
  });
  $('btnAddP').addEventListener('click', function () {
    readDraft();
    if (DRAFT.length >= MAXP) return;
    DRAFT.push({ name: '', cpu: false });
    drawPlayerRows();
    var n = $('pn' + (DRAFT.length - 1));
    if (n) n.focus();
  });
  $('settings').addEventListener('submit', function (e) {
    e.preventDefault();
    readDraft();
    var np = cleanPlayers(DRAFT);
    if (!np) {
      $('setHint').textContent = 'Il faut au moins 2 joueurs, dont un humain.';
      return;
    }
    var c = clean($('inGoal').value, $('inEntry').value);
    var changed = c.goal !== GOAL || c.entry !== ENTRY || np.length !== P.length || np.some(function (p, i) { return p.cpu !== P[i].cpu; });
    GOAL = c.goal; ENTRY = c.entry; P = np;
    saveSettings();
    fillForm();
    renderRules();
    if (changed) {
      newGame();
      $('setHint').textContent = 'Réglages enregistrés. Nouvelle partie lancée.';
    } else {
      render();
      $('setHint').textContent = 'Réglages enregistrés.';
    }
  });

  fillForm();
  renderRules();
  renderValues();
  drawSoundButton();
  newGame();
})();
</script>

</body></html>