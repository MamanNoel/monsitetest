    var c = [0, 0, 0, 0, 0, 0, 0], i, f;
    for (i = 0; i < n; i++) c[vals[i]]++;
    if (n === 6) {
      var ones = 0, twos = 0;
      for (f = 1; f <= 6; f++) { if (c[f] === 1) ones++; if (c[f] === 2) twos++; }
      if (ones === 6 || twos === 3) return 1500;
    }
    var total = 0;
    for (f = 1; f <= 6; f++) {
      var k = c[f];
      if (!k) continue;
      if (k >= 3) total += (f === 1 ? 1000 : f * 100) * Math.pow(2, k - 3);
      else if (f === 1) total += 100 * k;
